{
  "contractVersion": 1,
  "rpc": "google-colab.tools",
  "probe": {
    "action": "colab.probe"
  },
  "items": [
    {
      "id": "colab.runs",
      "kind": "events",
      "reads": "x-colab/run",
      "tool": "events_list",
      "input": {
        "source": "runs"
      },
      "accounts": {
        "named": true
      },
      "permission": {
        "events": "colab.events_list",
        "operations": [
          "colab.ledger.list"
        ]
      },
      "private": true,
      "cost": {
        "class": "free"
      },
      "maxBytes": 131072,
      "retentionDays": 90
    },
    {
      "id": "colab.runtimes",
      "kind": "snapshot",
      "tool": "runtimes_read",
      "input": {
        "source": "runtimes"
      },
      "output": "list",
      "accounts": {
        "named": true
      },
      "permission": {
        "tool": "colab.runtimes_read",
        "operations": [
          "colaboratory.runtimes.list",
          "aiplatform.projects.locations.notebookRuntimes.list"
        ]
      },
      "private": true,
      "cost": {
        "class": "free"
      },
      "maxAgeSec": 60,
      "maxBytes": 32768,
      "urlHosts": [
        "colab.research.google.com",
        "console.cloud.google.com"
      ]
    }
  ]
}
