{
  "name": "@we-the-rebel-alliance/colab-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCode plugin for local Jupyter notebooks: find, read and edit .ipynb files",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "colab",
    "jupyter",
    "notebooks"
  ],
  "homepage": "https://github.com/we-the-rebel-alliance/colab-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/colab-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/colab-plugin.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:kit": "node scripts/check.mjs kit",
    "test:host": "node scripts/check.mjs host",
    "test:latent": "node scripts/check.mjs latent",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check.mjs forbidden copies",
    "icons": "node scripts/check.mjs icons",
    "errors-doc": "node scripts/errors-doc.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#2fd55cdc0c6c1067927fefc403a88bfd18c9a971",
    "babel-preset-solid": "1.9.16",
    "effect": "4.1.0",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "opencode": {
    "host": ">=2.4.1 <2.5.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "google-colab",
      "name": "Colab",
      "domain": "colab.research.google.com"
    }
  },
  "jelly": {
    "title": "Colab",
    "summary": "Find, read and edit local Jupyter notebooks without a Google account.",
    "icon": "assets/icon.svg",
    "cost": "No Colab compute: the plugin edits local files and makes no Google requests.",
    "admin": "No sign-in, OAuth client or Cloud project is needed.",
    "tools": [
      {
        "name": "colab.find",
        "permission": "colab.find",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "colab.notebook",
        "permission": "colab.notebook",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "colab.edit",
        "permission": "colab.edit",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "colab",
      "colab-notebooks"
    ],
    "contributes": {
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin’s tools may do. Generates default rules for agents with a base allow; editing a local notebook is a change.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  }
}
